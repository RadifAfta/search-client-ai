# ========================================================
# Google Maps Lead Scraper Provider Configuration
# ========================================================

# Opsi 1: SerpApi (GRATIS 100 Search/Bulan, Daftar langsung tanpa kartu kredit di serpapi.com)
SERPAPI_KEY=your_serpapi_key_here

# Opsi 2: Google Places API Resmi (Memerlukan Google Cloud Console + kartu kredit terverifikasi)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
MAX_PLACES_API_CALLS=20

# Catatan: Jika kedua key di atas kosong, sistem otomatis berjalan dalam
# Mode Mock/Cache Terverifikasi UMKM Jember (Rp 0 selamanya tanpa API key).

# ========================================================
# AI Qualification & Copywriting Layer
# ========================================================
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ========================================================
# Telegram Messenger Layer (Opsional)
# ========================================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ========================================================
# Supabase Cloud Database (Diperlukan untuk Deploy Vercel)
# ========================================================
# Dapatkan di: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# ========================================================
# Dashboard & Outreach Personalization
# ========================================================
SENDER_NAME=Radif
SENDER_ROLE=freelance web developer di Jember
DASHBOARD_PIN=123456
PORT=3000
