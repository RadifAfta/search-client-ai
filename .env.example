# Meta Ads Library API Access Token (Required for Meta Ads scraper)
# Get a user access token with ads_management or general developer access from developer.facebook.com
META_ADS_ACCESS_TOKEN=your_meta_ads_access_token_here

# Twitter / X Credentials (Optional, but highly recommended for searching live tweets)
# Without login credentials or valid cookies, X will redirect search requests to the login page.
TWITTER_USERNAME=your_twitter_username_here
TWITTER_PASSWORD=your_twitter_password_here

# Optional: Direct Twitter Cookies in JSON format (array of cookie objects)
# If provided, the scraper will inject these cookies to bypass login flow entirely.
# Example: [{"name": "auth_token", "value": "xyz...", "domain": ".x.com", "path": "/"}]
TWITTER_COOKIES=
